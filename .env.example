APP_NAME="Project Documentor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Docker Compose overrides (optional — used instead of local DB_* vars)
# APP_PORT=8080
# DOCKER_DB_DATABASE=laravel
# DOCKER_DB_USERNAME=laravel
# DOCKER_DB_PASSWORD=secret
# DOCKER_DB_ROOT_PASSWORD=rootsecret

# Railway database — use ONLY DB_URL (delete DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD, DB_DATABASE):
#
#   DB_URL=${{Postgres.DATABASE_URL}}
#
# WRONG — do not put DATABASE_URL in DB_HOST:
#   DB_HOST=${{Postgres.DATABASE_URL}}
#
# PORT=80
# LOG_CHANNEL=stderr
# APP_KEY=base64:...
# DB_CONNECTION=pgsql
# DB_SSLMODE=require
# CACHE_STORE=database
# SESSION_DRIVER=database
# QUEUE_CONNECTION=database
