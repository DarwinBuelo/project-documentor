APP_NAME="Project Documentor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=cookie
QUEUE_CONNECTION=database

# Admin account (used by AdminUserSeeder)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Docker Compose overrides (optional — used instead of local DB_* vars)
# APP_PORT=8080
# DOCKER_DB_DATABASE=laravel
# DOCKER_DB_USERNAME=laravel
# DOCKER_DB_PASSWORD=secret
# DOCKER_DB_ROOT_PASSWORD=rootsecret

# Do NOT set PORT on Railway — Railway injects it automatically.
# In Railway Networking, the domain target port must match the injected PORT (usually 8080).
#
# DB_URL=${{Postgres.DATABASE_URL}}
# DB_CONNECTION=pgsql
# DB_SSLMODE=require
# LOG_CHANNEL=stderr
# APP_KEY=base64:...
# CACHE_STORE=file
# SESSION_DRIVER=cookie
# QUEUE_CONNECTION=database
