APP_NAME="Project Documentor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Docker Compose overrides (optional — used instead of local DB_* vars)
# APP_PORT=8080
# DOCKER_DB_DATABASE=laravel
# DOCKER_DB_USERNAME=laravel
# DOCKER_DB_PASSWORD=secret
# DOCKER_DB_ROOT_PASSWORD=rootsecret

# Railway (set these in the Railway dashboard; do not copy local .env values)
# PORT=80
# LOG_CHANNEL=stderr
# APP_KEY=base64:...  (from php artisan key:generate)
# DB_CONNECTION=pgsql
# DB_URL=${{Postgres.DATABASE_URL}}
# Or set individually:
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_USERNAME=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# DB_DATABASE=${{Postgres.PGDATABASE}}
